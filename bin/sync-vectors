#!/usr/bin/env bash
# Copies the test vectors from a checkout of the Predoza repository, which owns them.
# Usage: bin/sync-vectors ../predoza
set -euo pipefail

source="${1:?path to the predoza repository}/docs/host-sign-in/v2-vectors.json"
root="$(cd "$(dirname "$0")/.." && pwd)"

cp "$source" "$root/packages/predoza-php/tests/Fixtures/vectors.json"
echo "Synced from $(git -C "$(dirname "$source")" rev-parse --short HEAD)"

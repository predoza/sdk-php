{
    "name": "predoza/predoza-laravel",
    "description": "Laravel package for Predoza host sign-in: the handoff route, a Blade component for embedded games and a doctor command",
    "type": "library",
    "license": "MIT",
    "keywords": ["predoza", "laravel", "sign-in", "sso", "embed", "games"],
    "homepage": "https://github.com/predoza/predoza-laravel",
    "support": {
        "issues": "https://github.com/predoza/sdk-php/issues",
        "source": "https://github.com/predoza/predoza-laravel"
    },
    "require": {
        "php": "^8.2",
        "predoza/predoza-php": "^1.0",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/view": "^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Predoza\\Laravel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": ["Predoza\\Laravel\\PredozaServiceProvider"]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "minimum-stability": "stable"
}

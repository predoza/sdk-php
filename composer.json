{
    "name": "predoza/sdk-php",
    "description": "Development repository of the Predoza PHP SDK: predoza/predoza-php, predoza/predoza-symfony and predoza/predoza-laravel",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "paragonie/sodium_compat": "^2.1",
        "psr/clock": "^1.0"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "psr/http-factory": "^1.1",
        "psr/http-server-handler": "^1.0",
        "symfony/browser-kit": "^6.4 || ^7.4 || ^8.0",
        "symfony/console": "^6.4 || ^7.4 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.4 || ^8.0",
        "symfony/security-bundle": "^6.4 || ^7.4 || ^8.0",
        "symfony/twig-bundle": "^6.4 || ^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Predoza\\": "packages/predoza-php/src/",
            "Predoza\\Symfony\\": "packages/predoza-symfony/src/",
            "Predoza\\Laravel\\": "packages/predoza-laravel/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Predoza\\Tests\\": "packages/predoza-php/tests/",
            "Predoza\\Symfony\\Tests\\": "packages/predoza-symfony/tests/",
            "Predoza\\Laravel\\Tests\\": "packages/predoza-laravel/tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
